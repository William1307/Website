---
// CV PAGE — the recruiter's destination. Everything renders from src/data/cv.ts;
// the PDF download sits at the very top. Certifications live at the bottom as a
// COLLAPSED appendix (<details>) — this demotion is a brief requirement, do not
// promote them back to a page section.
import BaseLayout from '@layouts/BaseLayout.astro';
import { UI } from '@i18n/ui';
import { localeStaticPaths, type Locale } from '@i18n/locales';
import { CV } from '@data/cv';
import { CERTIFICATIONS } from '@data/certifications';
import { SITE } from '@data/site';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang as Locale;
const t = UI[lang];
---

<BaseLayout lang={lang} title={t.cv.pageTitle}>
  <article class="page cv">
    <header class="head">
      <div>
        <p class="annot">{t.cv.pageTitle}</p>
        <h1>{CV.personal.name}</h1>
        <p class="role">{CV.personal.role[lang]}</p>
        <p class="annot meta">
          {CV.personal.location} · {CV.personal.extras[lang].join(' · ')}
        </p>
      </div>
      <a class="download" href={SITE.cvPdf} download>{t.cv.download} ↓</a>
    </header>

    <p class="profile">{CV.personal.profile[lang]}</p>

    <div class="columns">
      <div class="main-col">
        <section>
          <h2 class="annot rubric">{t.cv.experience}</h2>
          {
            CV.experience.map((xp) => (
              <article class="entry">
                <div class="entry-head">
                  <h3>{xp.company}</h3>
                  <p class="annot">{xp.date[lang]}</p>
                </div>
                <p class="entry-role">{xp.role[lang]}</p>
                <ul>
                  {xp.bullets[lang].map((b) => <li>{b}</li>)}
                </ul>
                <p class="tags">{xp.tags.map((tag) => <span class="tag">{tag}</span>)}</p>
              </article>
            ))
          }
        </section>

        <section>
          <h2 class="annot rubric">{t.cv.education}</h2>
          {
            CV.education.map((ed) => (
              <article class="entry">
                <div class="entry-head">
                  <h3>{ed.school}</h3>
                  <p class="annot">{ed.date[lang]}</p>
                </div>
                <p class="entry-role">
                  {ed.degree[lang]}
                  {'award' in ed && ed.award ? ` — ${ed.award[lang]}` : ''}
                </p>
                <p class="annot">{ed.location}</p>
              </article>
            ))
          }
        </section>
      </div>

      <aside class="side-col">
        <section>
          <h2 class="annot rubric">{t.cv.skills}</h2>
          <dl>
            {
              CV.skills.map((s) => (
                <>
                  <dt class="annot">{s.category[lang]}</dt>
                  <dd>{typeof s.items === 'string' ? s.items : s.items[lang]}</dd>
                </>
              ))
            }
          </dl>
        </section>
        <section>
          <h2 class="annot rubric">{t.cv.languages}</h2>
          <dl>
            {
              CV.languages.map((l) => (
                <>
                  <dt class="annot">{l.name[lang]}</dt>
                  <dd>
                    {l.level[lang]}
                    {'detail' in l && l.detail ? <span class="detail"> — {l.detail[lang]}</span> : null}
                  </dd>
                </>
              ))
            }
          </dl>
        </section>
        <section>
          <h2 class="annot rubric">{t.cv.qualities}</h2>
          <p>{CV.qualities[lang].join(' · ')}</p>
        </section>
        <section>
          <h2 class="annot rubric">{t.cv.interests}</h2>
          <p>{CV.interests[lang].join(' · ')}</p>
        </section>
      </aside>
    </div>

    <!-- Appendix: certifications, deliberately collapsed. -->
    <section class="appendix">
      <h2 class="annot rubric">{t.cv.certifications}</h2>
      <p class="appendix-note">{t.cv.certificationsNote} — <a href={SITE.credly}>Credly ↗</a></p>
      {
        CERTIFICATIONS.map((cert) => (
          <details>
            <summary>
              <span class="cert-title">{cert.title}</span>
              <span class="annot">{t.cv.issuedBy} {cert.issuer}</span>
            </summary>
            <div class="cert-body">
              <img src={cert.badge} alt={`${cert.title} badge`} width="72" loading="lazy" />
              <div>
                <p>{cert.description[lang]}</p>
                <p class="tags">{cert.skills.map((s) => <span class="tag">{s}</span>)}</p>
                <p class="annot cert-links">
                  <a href={cert.verificationLink}>{t.cv.verify} ↗</a>
                  <a href={cert.certImage}>{lang === 'fr' ? 'Certificat (image)' : 'Certificate (image)'}</a>
                </p>
              </div>
            </div>
          </details>
        ))
      }
    </section>
  </article>
</BaseLayout>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-block: var(--space-5) var(--space-3);
    border-bottom: 2px solid var(--rule-strong);
  }
  h1 {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }
  .role {
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--ink-soft);
  }
  .meta {
    margin-top: var(--space-2);
  }
  .download {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--rust);
    padding: var(--space-2) var(--space-4);
    border-radius: 2px;
    text-decoration: none;
    white-space: nowrap;
  }
  .download:hover {
    background: var(--rust-deep);
  }
  .profile {
    max-width: var(--measure);
    margin-block: var(--space-4);
    font-style: italic;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
    gap: var(--space-6);
  }
  @media (max-width: 820px) {
    .columns {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
  .rubric {
    color: var(--rust);
    border-top: 1px solid var(--rule);
    padding-top: var(--space-2);
    margin-block: var(--space-4) var(--space-3);
  }
  .entry {
    margin-bottom: var(--space-4);
  }
  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .entry h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }
  .entry-role {
    font-style: italic;
    color: var(--ink-soft);
  }
  .entry ul {
    margin-top: var(--space-2);
    padding-left: 1.3em;
  }
  .entry li::marker {
    color: var(--rust);
  }
  .tags {
    margin-top: var(--space-2);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  dl {
    display: grid;
    gap: var(--space-1);
  }
  dt {
    margin-top: var(--space-2);
  }
  dd {
    margin: 0;
  }
  .detail {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  /* appendix: recessed paper, collapsed by default */
  .appendix {
    margin-top: var(--space-6);
    background: var(--paper-recessed);
    border: 1px solid var(--rule);
    padding: var(--space-4);
  }
  .appendix .rubric {
    border-top: none;
    margin-top: 0;
  }
  .appendix-note {
    font-size: var(--text-sm);
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }
  details {
    border-top: 1px solid var(--rule);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-block: var(--space-2);
    cursor: pointer;
    list-style: none;
  }
  summary::before {
    content: '▸';
    color: var(--rust);
    margin-right: var(--space-2);
  }
  details[open] summary::before {
    content: '▾';
  }
  .cert-title {
    font-weight: 560;
  }
  .cert-body {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3) 0 var(--space-4);
  }
  .cert-body img {
    flex-shrink: 0;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    padding: var(--space-1);
  }
  .cert-body p {
    font-size: var(--text-sm);
  }
  .cert-links {
    margin-top: var(--space-2);
    display: flex;
    gap: var(--space-3);
  }
</style>
