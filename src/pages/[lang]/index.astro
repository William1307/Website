---
// HOME — the journal's opening spread.
// Reading order (explicitly numbered on the page):
//   masthead → hero/about (№01) → projects (№02) → latest posts (№03)
//   → contact (№04)
// Certifications intentionally do NOT appear here — they are an appendix on /cv
// (see ACTION_PLAN.md "Demote" directive).
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHead from '@components/SectionHead.astro';
import PostListItem from '@components/PostListItem.astro';
import ContactSection from '@components/ContactSection.astro';
import { UI } from '@i18n/ui';
import { localeStaticPaths, type Locale } from '@i18n/locales';
import { getPosts } from '@i18n/posts';
import { PROJECTS } from '@data/projects';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang as Locale;
const t = UI[lang];
const latest = (await getPosts(lang)).slice(0, 3);
---

<BaseLayout lang={lang} title={t.hero.title}>
  <!-- № 01 · hero / about -->
  <section class="page hero">
    <p class="annot kicker">№ 01 — {t.hero.kicker}</p>
    <h1>
      <span class="name">{t.hero.name}</span>
      <span class="role">{t.hero.title}</span>
    </h1>
    <p class="lede">{t.hero.lede}</p>
    <div class="hero-actions">
      <a class="primary" href={`/${lang}/cv/`}>{t.hero.cvButton}</a>
      <a href="#contact">{t.hero.contactButton}</a>
    </div>
  </section>

  <!-- № 02 · projects, each linking to its write-up -->
  <section class="page">
    <SectionHead no="02" title={t.sections.projects} />
    <div class="projects">
      {
        PROJECTS.map((p, i) => (
          <article class="project">
            <p class="annot idx">{String(i + 1).padStart(2, '0')} · {p.category}</p>
            <h3>
              <a href={`/${lang}/blog/${p.article}/`}>{p.title}</a>
            </h3>
            <p class="desc">{p.description[lang]}</p>
            <p class="tech">{p.tech.map((x) => <span class="tag">{x}</span>)}</p>
            <p class="read">
              <a href={`/${lang}/blog/${p.article}/`} aria-label={`${t.blog.readArticle} — ${p.title}`}>
                {t.blog.readArticle} →
              </a>
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- № 03 · latest posts -->
  <section class="page">
    <SectionHead no="03" title={t.sections.writing} />
    {latest.map((post) => <PostListItem post={post} lang={lang} />)}
    <p class="all-link"><a href={`/${lang}/blog/`}>{t.sections.writingAll} →</a></p>
  </section>

  <!-- № 04 · contact -->
  <ContactSection lang={lang} no="04" />
</BaseLayout>

<style>
  /* -- hero: single-column editorial opener, flush left, ragged right.
     The name runs the width it needs; the lede is held to the reading measure.
     Bottom padding is lighter than the top because № 02's section-head already
     brings its own --space-6 of air above its rule. -- */
  .hero {
    padding-block: var(--space-6) var(--space-4);
  }
  .kicker {
    color: var(--rust);
    text-wrap: balance;
  }
  h1 {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .name {
    font-size: var(--text-display);
    font-weight: 620;
  }
  .role {
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 420;
    color: var(--ink-soft);
  }
  /* Lede set a step above body copy so it holds its own beside the display
     name; still capped at the reading measure (~65 characters per line). */
  .lede {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: calc(var(--text-base) * 1.1);
  }
  .hero-actions {
    margin-top: var(--space-4);
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
  }
  .hero-actions .primary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--rust);
    padding: var(--space-2) var(--space-4);
    border-radius: 2px;
    text-decoration: none;
  }
  .hero-actions .primary:hover {
    background: var(--rust-deep);
  }
  @media (max-width: 860px) {
    .hero {
      padding-block: var(--space-5) var(--space-3);
    }
    .lede {
      font-size: var(--text-base);
    }
  }

  /* -- projects: ruled two-column ledger -- */
  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-5);
  }
  @media (max-width: 720px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
  .project {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }
  .project .idx {
    color: var(--rust);
  }
  .project h3 {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    font-weight: 540;
  }
  .project h3 a {
    text-decoration: none;
  }
  .project h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--rust);
  }
  .desc {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }
  .tech {
    margin-top: var(--space-2);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .read {
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .all-link {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
