---
// HOME — the journal's opening spread.
// Reading order (explicitly numbered on the page):
//   masthead → hero/about (№01) → selected work (№02) → the workshop (№03)
//   → latest notes (№04) → contact (№05)
// Certifications intentionally do NOT appear here — they are an appendix on /cv
// (see ACTION_PLAN.md "Demote" directive).
import BaseLayout from '@layouts/BaseLayout.astro';
import SectionHead from '@components/SectionHead.astro';
import PostListItem from '@components/PostListItem.astro';
import PlotterSketch from '@components/PlotterSketch.astro';
import ContactSection from '@components/ContactSection.astro';
import { UI } from '@i18n/ui';
import { localeStaticPaths, type Locale } from '@i18n/locales';
import { getPosts } from '@i18n/posts';
import { PROJECTS } from '@data/projects';
import { INFRASTRUCTURE } from '@data/infrastructure';

export function getStaticPaths() {
  return localeStaticPaths();
}

const lang = Astro.params.lang as Locale;
const t = UI[lang];
const latest = (await getPosts(lang)).slice(0, 3);
---

<BaseLayout lang={lang} title={t.hero.title}>
  <!-- № 01 · hero / about -->
  <section class="page hero">
    <div class="hero-text">
      <p class="annot kicker">№ 01 — {t.hero.kicker}</p>
      <h1>
        <span class="name">{t.hero.name}</span>
        <span class="role">{t.hero.title}</span>
      </h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="hero-actions">
        <a class="primary" href={`/${lang}/cv/`}>{t.hero.cvButton}</a>
        <a href="#contact">{t.hero.contactButton}</a>
      </div>
    </div>
    <div class="hero-art">
      <PlotterSketch caption={t.hero.sketchCaption} />
    </div>
  </section>

  <!-- № 02 · selected work -->
  <section class="page">
    <SectionHead no="02" title={t.sections.projects} />
    <div class="projects">
      {
        PROJECTS.map((p, i) => (
          <article class="project">
            <p class="annot idx">{String(i + 1).padStart(2, '0')} · {p.category}</p>
            <h3>
              {p.article ? (
                <a href={`/${lang}/blog/${p.article}/`}>{p.title}</a>
              ) : p.link ? (
                <a href={p.link}>{p.title}</a>
              ) : (
                p.title
              )}
            </h3>
            <p class="desc">{p.description[lang]}</p>
            <p class="tech">{p.tech.map((x) => <span class="tag">{x}</span>)}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- № 03 · the workshop (honest infrastructure inventory) -->
  <section class="page">
    <SectionHead no="03" title={t.sections.infrastructure} />
    <p class="note">{t.sections.infrastructureNote}</p>
    <div class="machines">
      {
        INFRASTRUCTURE.map((m) => (
          <article class="machine">
            <h3>{m.name}</h3>
            <p class="annot">{m.hardware} · {m.os}</p>
            <p class="desc">{m.role[lang]}</p>
            <ul>
              {m.services.map((s) => <li>{s}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- № 04 · latest notes -->
  <section class="page">
    <SectionHead no="04" title={t.sections.writing} />
    {latest.map((post) => <PostListItem post={post} lang={lang} />)}
    <p class="all-link"><a href={`/${lang}/blog/`}>{t.sections.writingAll} →</a></p>
  </section>

  <!-- № 05 · contact -->
  <ContactSection lang={lang} no="05" />
</BaseLayout>

<style>
  /* -- hero: asymmetric editorial spread, art in the side column -- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(16rem, 4fr);
    gap: var(--space-5);
    align-items: end;
    padding-block: var(--space-6);
  }
  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: var(--space-5);
    }
    .hero-art {
      max-width: 26rem;
    }
  }
  .kicker {
    color: var(--rust);
  }
  h1 {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .name {
    font-size: var(--text-display);
    font-weight: 620;
  }
  .role {
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 420;
    color: var(--ink-soft);
  }
  .lede {
    margin-top: var(--space-4);
    max-width: var(--measure);
    font-size: var(--text-base);
  }
  .hero-actions {
    margin-top: var(--space-4);
    display: flex;
    gap: var(--space-4);
    align-items: baseline;
  }
  .hero-actions .primary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--rust);
    padding: var(--space-2) var(--space-4);
    border-radius: 2px;
    text-decoration: none;
  }
  .hero-actions .primary:hover {
    background: var(--rust-deep);
  }

  /* -- projects: ruled two-column ledger -- */
  .projects {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-5);
  }
  @media (max-width: 720px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
  .project {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
  }
  .project .idx {
    color: var(--rust);
  }
  .project h3 {
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    font-weight: 540;
  }
  .project h3 a {
    text-decoration: none;
  }
  .project h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--rust);
  }
  .desc {
    margin-top: var(--space-2);
    color: var(--ink-soft);
  }
  .tech {
    margin-top: var(--space-2);
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* -- workshop -- */
  .note {
    max-width: var(--measure);
    color: var(--ink-soft);
    font-style: italic;
    margin-bottom: var(--space-4);
  }
  .machines {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  @media (max-width: 860px) {
    .machines {
      grid-template-columns: 1fr;
    }
  }
  .machine {
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    padding: var(--space-4);
  }
  .machine h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }
  .machine .annot {
    margin-top: var(--space-1);
  }
  .machine ul {
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .machine li {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-1);
  }
  .machine li::before {
    content: '· ';
    color: var(--rust);
  }

  .all-link {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
</style>
