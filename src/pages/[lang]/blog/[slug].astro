---
// ARTICLE PAGE — one route per (locale, post-folder). Markdown is rendered by
// Astro; colocated images are optimized automatically. If a post exists in only
// one language, the missing locale's URL is simply not generated and the
// language toggle points at the blog index instead of a 404.
import BaseLayout from '@layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { UI } from '@i18n/ui';
import { formatDate, otherLocale, type Locale } from '@i18n/locales';
import { getPosts, type Post } from '@i18n/posts';
import { LOCALES } from '@i18n/locales';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    for (const post of await getPosts(lang)) {
      paths.push({ params: { lang, slug: post.slug }, props: { post } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const t = UI[lang];
const { post } = Astro.props as { post: Post };
const { title, date, excerpt, tags } = post.entry.data;
const { Content } = await render(post.entry);

const other = otherLocale(lang);
const altPath = post.availableIn.includes(other)
  ? `/${other}/blog/${post.slug}/`
  : `/${other}/blog/`;
---

<BaseLayout lang={lang} title={title} description={excerpt} altPath={altPath}>
  <article class="page">
    <header class="head">
      <p class="annot"><a href={`/${lang}/blog/`}>← {t.blog.backToList}</a></p>
      <h1>{title}</h1>
      <p class="meta annot">
        {t.blog.publishedOn} {formatDate(date, lang)}
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </p>
    </header>
    <div class="prose" data-copied={t.blog.copied} data-copy-label={t.blog.copyLabel}>
      <Content />
    </div>
    <p class="copy-status" aria-live="polite"></p>
    <!-- Icons for the code-block copy buttons, cloned by the script below. -->
    <template id="copy-icons">
      <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="8.5" y="8.5" width="12" height="12" rx="1.5"></rect>
        <path d="M15.5 8.5V5a1.5 1.5 0 0 0-1.5-1.5H5A1.5 1.5 0 0 0 3.5 5v9A1.5 1.5 0 0 0 5 15.5h3.5"></path>
      </svg>
      <svg class="icon-done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4.5 12.5l5 5 10-11"></path>
      </svg>
    </template>
  </article>
</BaseLayout>

<script>
  // A copy icon on every code block. Each <pre> is wrapped so the button stays
  // put while long lines scroll horizontally. Styles: .code-block and .copy-btn
  // in global.css (these elements are created here, at runtime).
  const prose = document.querySelector<HTMLElement>('.prose');
  const status = document.querySelector<HTMLElement>('.copy-status');
  const icons = document.querySelector<HTMLTemplateElement>('#copy-icons');
  const { copied = 'Copied!', copyLabel = 'Copy the code' } = prose?.dataset ?? {};

  prose?.querySelectorAll('pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'code-block';
    pre.replaceWith(wrap);
    wrap.append(pre);

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.title = copyLabel;
    btn.setAttribute('aria-label', copyLabel);
    if (icons) btn.append(icons.content.cloneNode(true));
    wrap.append(btn);

    btn.addEventListener('click', async () => {
      const text = (pre.querySelector('code') ?? pre).innerText.replace(/\n$/, '');
      try {
        await navigator.clipboard.writeText(text);
        btn.dataset.copied = '';
        if (status) status.textContent = copied;
        setTimeout(() => {
          delete btn.dataset.copied;
          if (status) status.textContent = '';
        }, 2000);
      } catch {
        // Clipboard unavailable: select the code so Ctrl/Cmd+C works.
        const range = document.createRange();
        range.selectNodeContents(pre);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
      }
    });
  });
</script>

<style>
  .head {
    padding-block: var(--space-5) var(--space-3);
    margin-bottom: var(--space-4);
    border-bottom: 2px solid var(--rule-strong);
    max-width: var(--measure);
  }
  h1 {
    font-size: var(--text-xl);
    margin-top: var(--space-3);
  }
  .meta {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    align-items: baseline;
  }
</style>
