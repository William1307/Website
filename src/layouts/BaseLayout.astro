---
// The single page shell. Every page renders through this layout, which owns:
//   - <head>: SEO meta, canonical + hreflang alternates, fonts, global CSS
//   - the masthead (nav) — the CV link is ALWAYS visible here, per the brief:
//     a recruiter must reach the CV in one click from anywhere. The masthead is
//     sticky, so that stays true at any scroll depth.
//   - the footer (colophon)
//   - the light/dark ("lamplight") toggle, applied before first paint
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { SITE } from '@data/site';
import { UI } from '@i18n/ui';
import { LOCALES, LOCALE_NAMES, otherLocale, type Locale } from '@i18n/locales';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  /**
   * Path of this page in the other language, for the FR/EN switch and hreflang.
   * Defaults to swapping the /fr/ ↔ /en/ prefix of the current URL — pages only
   * override this when the translated page lives at a different path.
   */
  altPath?: string;
}

const { lang, title, description = SITE.description[lang] } = Astro.props;
const t = UI[lang];
const other = otherLocale(lang);
const currentPath = Astro.url.pathname;
// Pages outside the /<lang>/ tree (the 404, served at any URL) have no twin:
// their language switch goes to the other locale's home page instead, and they
// emit no hreflang alternates (that home page is not their translation).
const inLocaleTree = currentPath === `/${lang}` || currentPath.startsWith(`/${lang}/`);
const hasTwin = Astro.props.altPath !== undefined || inLocaleTree;
const altPath =
  Astro.props.altPath ?? (inLocaleTree ? currentPath.replace(`/${lang}`, `/${other}`) : `/${other}/`);

// "You are here": compare with a trailing slash (trailingSlash is 'ignore').
const here = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const homeHref = `/${lang}/`;
const cvHref = `/${lang}/cv/`;
const nav = [
  { href: homeHref, label: t.nav.home, current: here === homeHref },
  // the posts index and every individual post count as "Posts"
  { href: `/${lang}/blog/`, label: t.nav.blog, current: here.startsWith(`/${lang}/blog/`) },
  { href: `/${lang}/gallery/`, label: t.nav.gallery, current: here === `/${lang}/gallery/` },
  // Contact is a section of the home page, never "the page you are on".
  { href: `/${lang}/#contact`, label: t.nav.contact, current: false },
];
const cvCurrent = here === cvHref;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE.title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(currentPath, Astro.site)} />
    {
      hasTwin && (
        <>
          <link rel="alternate" hreflang={other} href={new URL(altPath, Astro.site)} />
          <link rel="alternate" hreflang={lang} href={new URL(currentPath, Astro.site)} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={`${title} · ${SITE.title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <script is:inline>
      // Apply the stored theme BEFORE first paint to avoid a flash.
      // "auto" (no key) follows prefers-color-scheme via CSS alone.
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || stored === 'light') {
          document.documentElement.dataset.theme = stored;
        }
      } catch (e) {
        /* storage blocked: stay on "auto" */
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>

    <header class="masthead">
      <div class="masthead-inner page">
        <a class="wordmark" href={homeHref}>K.&nbsp;Fauvette</a>

        <nav class="site-nav" aria-label={t.nav.main}>
          <ul role="list">
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                    <span class="label">{item.label}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a class="cv-link" href={cvHref} aria-current={cvCurrent ? 'page' : undefined}>
                <span class="label">{t.nav.cv}</span>
              </a>
            </li>
          </ul>
        </nav>

        <div class="controls">
          <div class="lang-switch" role="group" aria-label={t.nav.langGroup}>
            {
              LOCALES.map((code) =>
                code === lang ? (
                  <span class="lang-opt" aria-current="true" title={LOCALE_NAMES[code]}>
                    {code.toUpperCase()}
                  </span>
                ) : (
                  <a class="lang-opt" href={altPath} hreflang={code} lang={code} title={t.nav.langLabel}>
                    {code.toUpperCase()}
                  </a>
                ),
              )
            }
          </div>

          <button
            class="ghost-btn theme-toggle"
            id="theme-toggle"
            type="button"
            title={t.theme.hintAuto}
            data-hint-auto={t.theme.hintAuto}
            data-hint-dark={t.theme.hintDark}
            data-hint-light={t.theme.hintLight}
          >
            <span class="sr-only">{t.theme.prefix}</span>
            {/* All three states are rendered; CSS shows the one matching <html data-theme>,
                so the label is right from first paint (the pre-paint script sets it). */}
            <span class="theme-state" data-mode="auto">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
              </svg>
              <span class="theme-name">{t.theme.auto}</span>
            </span>
            <span class="theme-state" data-mode="dark">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M20.5 13.6A8.5 8.5 0 1 1 10.4 3.5a6.6 6.6 0 0 0 10.1 10.1z"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"></path>
              </svg>
              <span class="theme-name">{t.theme.dark}</span>
            </span>
            <span class="theme-state" data-mode="light">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle>
                <path
                  d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"></path>
              </svg>
              <span class="theme-name">{t.theme.light}</span>
            </span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer page">
      <div class="footer-rule" aria-hidden="true"></div>
      <div class="footer-row">
        <p class="annot">© {new Date().getFullYear()} — {SITE.title} · {SITE.domain}</p>
        <p class="annot links">
          <a href={SITE.github}>GitHub</a>
          <a href={SITE.linkedin}>LinkedIn</a>
          <a href={`mailto:${SITE.email}`}>Email</a>
        </p>
      </div>
      <p class="annot colophon">{t.footer.colophon}</p>
    </footer>

    <script>
      // Three-state theme cycle: auto → dark → light → auto.
      // The visible label follows <html data-theme> through CSS; only the
      // tooltip (what the next click does) is kept in sync here.
      const root = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const syncHint = () => {
        if (!btn) return;
        const mode = root.dataset.theme ?? 'auto';
        const key = `hint${mode[0].toUpperCase()}${mode.slice(1)}`;
        btn.title = btn.dataset[key] ?? '';
      };
      syncHint();
      btn?.addEventListener('click', () => {
        const cur = root.dataset.theme ?? null;
        const next = cur === 'dark' ? 'light' : cur === 'light' ? null : 'dark';
        if (next) root.dataset.theme = next;
        else delete root.dataset.theme;
        try {
          if (next) localStorage.setItem('theme', next);
          else localStorage.removeItem('theme');
        } catch {
          /* storage blocked: the choice lasts for this page view only */
        }
        syncHint();
      });

      // Keep in-page anchors (#main, #contact…) clear of the sticky masthead:
      // publish its real height for the scroll-padding rule below.
      const masthead = document.querySelector<HTMLElement>('.masthead');
      if (masthead && 'ResizeObserver' in window) {
        new ResizeObserver(() => {
          root.style.setProperty('--masthead-h', `${masthead.offsetHeight}px`);
        }).observe(masthead);
      }

      // Remember an explicit language choice: the root URL (/) honours it over
      // its time-zone guess on the next visit (see src/pages/index.astro).
      document.querySelectorAll<HTMLAnchorElement>('.lang-switch a[hreflang]').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('lang', a.hreflang);
          } catch {
            /* storage blocked: the root URL falls back to its guess */
          }
        });
      });
    </script>

    <style>
      /* Fallback heights until the script measures the real one. */
      :global(:root) {
        --masthead-h: calc(5.5rem + 1px);
      }
      @media (min-width: 56rem) {
        :global(:root) {
          --masthead-h: 4rem;
        }
      }
      :global(html) {
        scroll-padding-top: calc(var(--masthead-h) + var(--space-3));
      }

      .skip {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--rust);
        color: var(--paper);
        padding: var(--space-2) var(--space-3);
        z-index: 100;
      }
      .skip:focus {
        left: 0;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
      }

      /* ---- masthead ---------------------------------------------------- */
      /* Full-bleed sticky band (solid paper so text never shows through);
         the hairline rule stays on the page column, as before. */
      .masthead {
        position: sticky;
        top: 0;
        z-index: 50;
        background: var(--paper);
      }
      .masthead-inner {
        display: grid;
        grid-template-columns: 1fr auto;
        grid-template-areas:
          'brand controls'
          'nav   nav';
        align-items: center;
        column-gap: var(--space-3);
        padding-top: var(--space-2);
        border-bottom: 1px solid var(--rule);
      }
      @media (min-width: 56rem) {
        .masthead-inner {
          grid-template-columns: auto 1fr auto;
          grid-template-areas: 'brand nav controls';
          column-gap: var(--space-4);
          min-height: 4rem;
          padding-top: 0;
        }
      }

      .wordmark {
        grid-area: brand;
        justify-self: start;
        font-style: italic;
        font-weight: 600;
        font-size: var(--text-lg);
        line-height: 1.2;
        text-decoration: none;
      }

      /* ---- primary nav ---- */
      .site-nav {
        /* side padding of each link, i.e. how far the tab overhangs the text */
        --nav-pad: var(--space-1);
        grid-area: nav;
        align-self: stretch;
        display: flex;
      }
      .site-nav ul {
        list-style: none;
        padding: 0;
        display: flex;
        align-items: stretch;
        flex-wrap: wrap;
        column-gap: var(--space-3);
        /* pull the first link back so its text lines up with the wordmark */
        margin-inline: calc(-1 * var(--nav-pad));
        width: calc(100% + 2 * var(--nav-pad));
      }
      @media (max-width: 35.99rem) {
        /* phone: spread the five items edge to edge, like a tab bar */
        .site-nav {
          --nav-pad: 0px;
        }
        .site-nav ul {
          justify-content: space-between;
          column-gap: var(--space-2);
        }
      }
      .site-nav li {
        display: flex;
      }
      .site-nav a {
        position: relative;
        display: flex;
        align-items: center;
        min-height: 2.75rem; /* 44px tap target */
        padding-inline: var(--nav-pad);
        font-family: var(--font-mono);
        font-size: var(--text-sm);
        line-height: 1.2;
        color: var(--ink-soft);
        text-decoration: none;
        white-space: nowrap;
      }
      @media (max-width: 21rem) {
        /* 320px phones: keep all five items on one row */
        .site-nav ul {
          column-gap: var(--space-1);
        }
        .site-nav a {
          font-size: var(--text-xs);
        }
      }
      /* "You are here" marker: a rust tab sitting on the masthead's rule.
         Hover previews it in neutral ink. */
      .site-nav a::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        bottom: -1px;
        height: 2px;
        background: transparent;
        transition: background-color 120ms ease;
      }
      .site-nav a:hover {
        color: var(--ink);
      }
      @media (hover: hover) {
        .site-nav a:hover::after {
          background: var(--rule-strong);
        }
      }
      .site-nav a[aria-current='page'] {
        color: var(--ink);
        font-weight: 500;
      }
      .site-nav a[aria-current='page']::after {
        background: var(--rust);
      }
      /* Focus ring hugs the label, not the full-height tap area. */
      .site-nav a:focus-visible {
        outline: none;
      }
      .site-nav a:focus-visible .label {
        outline: 2px solid var(--rust);
        outline-offset: 4px;
        border-radius: 1px;
      }

      /* The CV link is the one visually loud element in the masthead. */
      .site-nav .cv-link .label {
        color: var(--paper);
        background: var(--rust);
        padding: 0.3em 0.75em;
        border-radius: 2px;
        transition: background-color 120ms ease;
      }
      .site-nav .cv-link:hover .label {
        background: var(--rust-deep);
      }
      .site-nav .cv-link::after {
        /* the tab matches the button's width, not its tap area */
        inset-inline: var(--nav-pad);
      }
      .site-nav .cv-link:focus-visible .label {
        outline-offset: 3px;
      }

      /* ---- controls: language + theme ---- */
      .controls {
        grid-area: controls;
        display: flex;
        align-items: center;
        gap: var(--space-2);
      }
      .lang-switch,
      .theme-toggle {
        font-family: var(--font-mono);
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        line-height: 1;
        height: 2.25rem;
        border: 1px solid var(--rule);
        border-radius: 2px;
      }
      @media (min-width: 56rem) {
        .lang-switch,
        .theme-toggle {
          height: 2rem;
        }
      }
      .lang-switch {
        display: flex;
      }
      .lang-opt {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 2.5rem;
        /* trailing letter-spacing would push the code off-centre */
        padding-inline: 0.62em 0.5em;
        color: var(--ink-soft);
        text-decoration: none;
      }
      .lang-opt + .lang-opt {
        border-left: 1px solid var(--rule);
      }
      a.lang-opt:hover {
        color: var(--rust);
      }
      a.lang-opt:focus-visible {
        /* inset, so the ring stays inside its own cell */
        outline-offset: -5px;
      }
      .lang-opt[aria-current] {
        color: var(--ink);
        font-weight: 500;
        background: var(--paper-recessed);
        box-shadow: inset 0 -2px 0 var(--rust);
      }

      .theme-toggle {
        display: grid;
        align-items: center;
        padding-inline: 0.6em;
        color: var(--ink-soft);
      }
      .theme-toggle:hover {
        color: var(--rust);
        border-color: var(--rust);
      }
      .theme-state {
        /* stack all three states in one cell: the button keeps the width of
           the longest label, so it never jumps when cycling */
        grid-area: 1 / 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5em;
        visibility: hidden;
      }
      .theme-state svg {
        width: 0.95rem;
        height: 0.95rem;
        flex: none;
      }
      :global(:root:not([data-theme])) .theme-state[data-mode='auto'],
      :global(:root[data-theme='dark']) .theme-state[data-mode='dark'],
      :global(:root[data-theme='light']) .theme-state[data-mode='light'] {
        visibility: visible;
      }
      /* very narrow phones: icon only (the name stays in the accessible label) */
      @media (max-width: 22.4rem) {
        .theme-name {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip: rect(0 0 0 0);
          white-space: nowrap;
        }
      }

      @media print {
        .masthead {
          position: static;
        }
        .controls {
          display: none;
        }
      }

      /* ---- footer ---- */
      .footer {
        margin-top: var(--space-6);
        padding-block: var(--space-4);
      }
      .footer-rule {
        border-top: 2px solid var(--rule-strong);
        margin-bottom: var(--space-3);
      }
      .footer-row {
        display: flex;
        justify-content: space-between;
        gap: var(--space-3);
        flex-wrap: wrap;
      }
      .links {
        display: flex;
        gap: var(--space-3);
      }
      .colophon {
        margin-top: var(--space-2);
        color: var(--ink-faint);
      }
    </style>
  </body>
</html>
