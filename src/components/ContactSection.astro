---
// Contact block: direct channels + a Formspree form (no backend of our own).
// The form is progressively enhanced — without JS it still POSTs to Formspree
// and the visitor lands on Formspree's confirmation page.
import { SITE } from '@data/site';
import { UI } from '@i18n/ui';
import type { Locale } from '@i18n/locales';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Locale;
  no: string;
}
const { lang, no } = Astro.props;
const t = UI[lang];
---

<section class="page">
  <SectionHead no={no} title={t.sections.contact} id="contact" />
  <div class="grid">
    <div>
      <p class="lede">{t.sections.contactLede}</p>
      <ul class="channels">
        <li><span class="annot">email</span><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><span class="annot">linkedin</span><a href={SITE.linkedin}>kristofer-fauvette</a></li>
        <li><span class="annot">github</span><a href={SITE.github}>William1307</a></li>
      </ul>
    </div>

    <form
      id="contact-form"
      action={SITE.formspreeEndpoint}
      method="POST"
      data-sending={t.contactForm.sending}
      data-success={t.contactForm.success}
      data-error={t.contactForm.error}
    >
      <label>
        <span class="annot">{t.contactForm.email}</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>
      <label>
        <span class="annot">{t.contactForm.message}</span>
        <textarea name="message" rows="5" required></textarea>
      </label>
      <button type="submit">{t.contactForm.send}</button>
      <p class="annot status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // Inline submission so the visitor stays on the page. Status strings are
  // read from data attributes to keep all copy in src/i18n/ui.ts.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('.status') as HTMLElement;
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    status.textContent = form.dataset.sending ?? '…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = form.dataset.success ?? 'OK';
      form.reset();
    } catch {
      status.textContent = form.dataset.error ?? 'Error';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    max-width: 56rem;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .lede {
    max-width: var(--measure);
    color: var(--ink-soft);
  }
  .channels {
    list-style: none;
    padding: 0;
    margin-top: var(--space-4);
  }
  .channels li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }
  .channels .annot {
    min-width: 5.5rem;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  input,
  textarea {
    font: inherit;
    color: var(--ink);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 2px;
    padding: var(--space-2);
    resize: vertical;
  }
  input:focus,
  textarea:focus {
    outline: 2px solid var(--rust);
    outline-offset: 1px;
  }
  button {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--rust);
    border: none;
    border-radius: 2px;
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    align-self: flex-start;
  }
  button:hover {
    background: var(--rust-deep);
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .status:empty {
    display: none;
  }
</style>
